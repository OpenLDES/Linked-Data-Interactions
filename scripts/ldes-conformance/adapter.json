{
  "protocolVersion": 0,
  "id": "openldes-ldi",
  "name": "LDES conformance adapter for OpenLDES LDI",
  "revision": "1",
  "client": {
    "id": "openldes-ldi-client",
    "name": "OpenLDES Linked Data Interactions client",
    "homepage": "https://github.com/OpenLDES/Linked-Data-Interactions/tree/main/ldi-core/ldes-client",
    "version": "3.1.1",
    "revision": "unknown"
  },
  "command": [
    "node",
    "adapters/openldes-ldi/adapter.mjs"
  ],
  "timeoutMs": 45000,
  "capabilities": {
    "modes": [
      "unordered",
      "ordered"
    ],
    "memberExtraction": true,
    "context": true,
    "persistentState": true
  }
}
